# Python
__pycache__/
*.pyc

# Generated mesh/run outputs (regenerate by running the pipeline)
runs/
*.msh
*.h5
*.hdf
*.geo_unrolled
*.log

# SLURM / Fortran runtime output
*.swp
out.o
error.e
fort.*

# Stale dumps from the (now removed) dump_wall_coords diagnostic
wall_coords_*.dat

# high_order_mesh/ is smoothing-step tooling (config/scripts/spline tables),
# not a place to accumulate sod2d run output -- unlike prod_run/, where
# surf_code_*/timer_* are kept as reference results.
/Construct2D_to_SOD2D/high_order_mesh/surf_code_*.dat
/Construct2D_to_SOD2D/high_order_mesh/paramQual.txt
/Construct2D_to_SOD2D/high_order_mesh/roughness.dat

# Scratch verification runs, not part of the deliverable pipeline
/Construct2D_to_SOD2D/high_order_mesh_test_cgrd/
/Construct2D_to_SOD2D/high_order_mesh_test_new/

# Production runs: copy the smoothed mesh out of high_order_mesh/ and run
# wherever -- no dedicated production-run directory is tracked here.
/Construct2D_to_SOD2D/prod_run/

# Construct2D_to_NEKRS/: no large generated mesh/geometry/binary/run-output
# files are tracked -- regenerate via Construct2D_to_NEKRS/README.md.
/Construct2D_to_NEKRS/linear_mesh/*.re2
/Construct2D_to_NEKRS/linear_mesh/smooth_2D/*.re2
/Construct2D_to_NEKRS/linear_mesh/smooth_2D/*.rea
/Construct2D_to_NEKRS/linear_mesh/smooth_2D/*.ma2
/Construct2D_to_NEKRS/linear_mesh/smooth_2D/geom_3x3*.dat
/Construct2D_to_NEKRS/linear_mesh/smooth_2D/*.f0*
/Construct2D_to_NEKRS/linear_mesh/smooth_2D/*.nek5000
/Construct2D_to_NEKRS/linear_mesh/smooth_2D/SESSION.NAME
/Construct2D_to_NEKRS/linear_mesh/smooth_2D/.state
/Construct2D_to_NEKRS/linear_mesh/smooth_2D/makefile
/Construct2D_to_NEKRS/linear_mesh/smooth_2D/nek5000
/Construct2D_to_NEKRS/linear_mesh/smooth_2D/obj/
/Construct2D_to_NEKRS/high_order_mesh/*/*.re2
/Construct2D_to_NEKRS/high_order_mesh/*/*.ma2
/Construct2D_to_NEKRS/high_order_mesh/*/geom_3x3*.dat
/Construct2D_to_NEKRS/high_order_mesh/*/*.f0*
/Construct2D_to_NEKRS/high_order_mesh/*/base.fld
/Construct2D_to_NEKRS/high_order_mesh/*/newrea.out
/Construct2D_to_NEKRS/high_order_mesh/*/cmake.log
/Construct2D_to_NEKRS/high_order_mesh/*/.cache/
/Construct2D_to_NEKRS/high_order_mesh/*/SESSION.NAME

# pyHyp/: no generated volume meshes or downloaded surface meshes are
# tracked -- regenerate via pyHyp/README.md.
/pyHyp/example_*/volumeMesh.*
/pyHyp/example_*/logMeshGeneration.txt
/pyHyp/example_*/*.cgns.tar.gz

# etaGrid_to_SOD2D/examples/: an actual example input mesh (not a
# pipeline-generated output like the blanket *.msh rule above assumes),
# kept intentionally despite the known degenerate-quad issue noted in
# etaGrid_to_SOD2D/README.md -- to be replaced with a repaired version.
!/etaGrid_to_SOD2D/examples/airfoil.msh

# Vendored/compiled binaries (rebuild from source)
/Construct2D/construct2d
/Construct2D/bin/x86_64/Linux/construct2d
/Construct2D_to_SOD2D/linear_mesh/sod2d_tools/tool_meshConversorPar

# Claude Code local settings (machine-specific, not reviewed for repo)
.claude/
