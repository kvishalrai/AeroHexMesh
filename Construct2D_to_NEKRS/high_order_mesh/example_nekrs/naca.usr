c-----------------------------------------------------------------------
      subroutine usrdat2()  ! This routine to modify mesh coordinates
      include 'SIZE'
      include 'TOTAL'

      integer e, f
      real    sn(3), sr(3), tol
      real    tmp(lx1, ly1, lz1, nelt)
      real    xmid, ymid, zmid
      real    xref, yref, zref
      real    dxref, dyref, dzref, rtmp

      common /clcd/ U0,alpha,cos_alpha,sin_alpha

      integer lt
      parameter (lt=lx1*ly1*lz1*lelt)
      real mask(lt), h1(lt), x0, x1

      common /foilrot/ xcen, ycen, trot
      real xrot, yrot
      
      ntot = nx1*ny1*nz1*nelt

      xcen  = 1.
      ycen  = 0.

      U0    = 1.
      alpha = 5.   ! in degrees
      trot  = alpha

      cos_alpha = cos(pi*alpha/180.)
      sin_alpha = sin(pi*alpha/180.)

      ux   = U0*cos_alpha
      uy   = U0*sin_alpha
      uz   = 0.0

      if (nio.eq.0) write(*,*)'AOA = ', alpha

      !Set all non-periodic BCs here. This is required by gmsh2nek
      do iel=1,nelv
         do ifc=1,2*ndim
            id_face = bc(5,ifc,iel,1)
            if (id_face.eq.1) then        ! Wall
               cbc(ifc,iel,1) = 'W  '
               boundaryID(ifc,iel) = 1
            elseif (id_face.eq.2) then    ! Inlet
               cbc(ifc,iel,1) = 'v  '
               boundaryID(ifc,iel) = 2
            elseif (id_face.eq.3) then    ! Outlet
               cbc(ifc,iel,1) = 'O  '
               boundaryID(ifc,iel) = 3
            else                          ! Zero-out everything else
               boundaryID(ifc,iel) = 0
            endif
         enddo
      enddo

cc      !Set all non-periodic BCs here. This is required by gmsh2nek
cc      do iel=1,nelv
cc         do ifc=1,2*ndim
cc            id_face = bc(5,ifc,iel,1)
cc            if (id_face.eq.1) then        ! Wall
cc               cbc(ifc,iel,1) = 'W  '
cc               boundaryID(ifc,iel) = 1
cc            elseif (id_face.eq.2) then    ! Inlet
ccc               cbc(ifc,iel,1) = 'v  '
cc               cbc(ifc,iel,1) = 'W01'
cc               boundaryID(ifc,iel) = 2
cc            elseif (id_face.eq.3) then    ! Outlet
ccc               cbc(ifc,iel,1) = 'O  '
cc               cbc(ifc,iel,1) = 'W01'
cc               boundaryID(ifc,iel) = 3
cc            else                          ! Zero-out everything else
cc               boundaryID(ifc,iel) = 0
cc            endif
cc         enddo
cc      enddo

cc      do e=1,nelv
cc      do f=1,2*ldim
cc
cc         boundaryid(f,e) = 0
cc
cc         if (cbc(f,e,1).eq.'W  ') boundaryid(f,e) = 1
cc         if (cbc(f,e,1).eq.'W01') then
cc
cc            tmp1 = 0.0
cc            nxz = lx1*lz1
cc
cc            do i=1,nxz
cc              tmp1 = tmp1 + ( unx(i,1,f,e)*ux
cc     $                      + uny(i,1,f,e)*uy
cc     $                      + unz(i,1,f,e)*uz)*area(i,1,f,e)
cc            enddo
cc
cc            if (tmp1.lt.0) then
cc               cbc(f,e,1) = 'v  '
cc               boundaryid(f,e) = 2
cc            else
cc               cbc(f,e,1) = 'O  '
cc               boundaryid(f,e) = 3
cc            endif
cc         endif
cc
cc      enddo
cc      enddo



c..   set the boundaryMap for the scalar k and tau
      do e=1,nelt
        do f=1,2*ndim
          cbc(f,e,2) = cbc(f,e,1)
          cbc(f,e,3) = cbc(f,e,1)
          cbc(f,e,4) = cbc(f,e,1)
          if (cbc(f,e,1) .eq. 'v  ') cbc(f,e,2) = 't  '
          if (cbc(f,e,1) .eq. 'v  ') cbc(f,e,3) = 't  '
          if (cbc(f,e,1) .eq. 'v  ') cbc(f,e,4) = 't  '

          if (cbc(f,e,1) .eq. 'O  ') cbc(f,e,2) = 'O  '
          if (cbc(f,e,1) .eq. 'O  ') cbc(f,e,3) = 'O  '
          if (cbc(f,e,1) .eq. 'O  ') cbc(f,e,4) = 'O  '

          if (cbc(f,e,1) .eq. 'o  ') cbc(f,e,2) = 'o  '
          if (cbc(f,e,1) .eq. 'o  ') cbc(f,e,3) = 'o  '
          if (cbc(f,e,1) .eq. 'o  ') cbc(f,e,4) = 'o  '

          if (cbc(f,e,1) .eq. 'W  ') cbc(f,e,2) = 't  '
          if (cbc(f,e,1) .eq. 'W  ') cbc(f,e,3) = 't  '
          if (cbc(f,e,1) .eq. 'W  ') cbc(f,e,4) = 't  '
        enddo
      enddo

      call get_smooth_data  ! Smooth the blade surface geometry
      call fix_geom
      call geom_reset(1)
      call gen_rea(2)

      return
      end
c-----------------------------------------------------------------------

      subroutine usrdat3
      include 'SIZE'
      include 'TOTAL'

      common /walldist/ ywd(lx1,ly1,lz1,lelt)
      real ywd
      real ymax

      real w1,w2,w3,w4,w5
      common /SCRNS/
     &     w1(lx1*ly1*lz1*lelv)
     &     ,w2(lx1*ly1*lz1*lelv)
     &     ,w3(lx1*ly1*lz1*lelv)
     &     ,w4(lx1*ly1*lz1*lelv)
     &     ,w5(lx1*ly1*lz1*lelv)

      common /NRSSCPTR/ nrs_scptr(1)
      integer*8 nrs_scptr

      nxyz = lx1*ly1*lz1
      ntot = nxyz*nelt

      call cheap_dist(ywd,1,'W  ')
      !call distf(ywd,1,'W  ',w1,w2,w3,w4,w5)
      nrs_scptr(1) = loc(ywd(1,1,1,1))

      ymax = glmax(ywd,ntot)

cc      write(*,*) '--||NEK_CHECK :: ', ymax

      return
      end
c-----------------------------------------------------------------------
      subroutine get_smooth_data
      include 'SIZE'
      include 'TOTAL'

      integer e,eg,exy,ez,f

      parameter (lelxy=NUMBER_ELEMENTS_X*NUMBER_ELEMENTS_Y) ! Number of elements in 2D airfoil section
      common /ctmp2/ xy4(4*4,2,lelxy)

      parameter (lw=lx1*ly1*lz1*lelt)
      common /scruz/ w(lw)

      n     = lx1*ly1*lz1*nelt
      nface = 2*ldim

      if (nid.eq.0) then

       open (unit=31,file='geom_3x3_naca_gen_spline_info.dat')
       do exy=1,lelxy
       do i=1,4*4
          read(31,*) xy4(i,1,exy),xy4(i,2,exy)
       enddo
       enddo
       close(31)

      endif

      m   = 4*4*2                   ! Number of entries
      call bcast(xy4,m*lelxy*wdsize) ! Broadcast: 0-->all ranks

      do e=1,nelv                   ! Interpolate to each element
        eg  = lglel(e)
        e2d = mod1(eg,lelxy)
        call map_m_to_n(xm1(1,1,1,e),lx1,xy4(1,1,e2d),4,if3d,w,lw)
        call map_m_to_n(ym1(1,1,1,e),lx1,xy4(1,2,e2d),4,if3d,w,lw)

        if (lz1.gt.1) then
         lxy = lx1*ly1
         do iz=2,lz1                 ! Extrude 1st layer to other GLL layers
           call copy(xm1(1,1,iz,e),xm1(1,1,1,e),lxy)
           call copy(ym1(1,1,iz,e),ym1(1,1,1,e),lxy)
         enddo
        endif

      enddo

c     call outpost(xm1,ym1,zm1,pr,t,'   ')

      call geom_reset(1)

      return
      end
c-----------------------------------------------------------------------
      function dongOutflow(ix,iy,iz,iel,iside,u0,delta)
      include 'SIZE'
      include 'SOLN'
      include 'GEOM'
      real sn(3)
      ux = vx(ix,iy,iz,iel)
      uy = vy(ix,iy,iz,iel)
      uz = vz(ix,iy,iz,iel)
      call getSnormal(sn,ix,iy,iz,iside,iel)
      vn = ux*sn(1) + uy*sn(2) + uz*sn(3)
      S0 = 0.5*(1.0 - tanh(vn/u0/delta))
      dongOutflow = -0.5*(ux*ux+uy*uy+uz*uz)*S0
      return
      end
c-----------------------------------------------------------------------
      subroutine filter_length

      include 'SIZE'
      include 'TOTAL'

      common /Dgrdelm/ dxgrd(lelt), dygrd(lelt), dzgrd(lelt)
     $               , dgrd  (lx1,ly1,lz1,lelt)

      n   = lx1*ly1*lz1*lelt
      nxyz= lx1*ly1*lz1

      call rzero(dxgrd, lelt)
      call rzero(dygrd, lelt)
      call rzero(dzgrd, lelt)
      call rzero(dgrd,  lelt)

      do iel=1,nelv

         xmax = vlmax(xm1(1,1,1,iel),nxyz)
         xmin = vlmin(xm1(1,1,1,iel),nxyz)

         ymax = vlmax(ym1(1,1,1,iel),nxyz)
         ymin = vlmin(ym1(1,1,1,iel),nxyz)

         zmax = vlmax(zm1(1,1,1,iel),nxyz)
         zmin = vlmin(zm1(1,1,1,iel),nxyz)

         dxgrd(iel)= (xmax - xmin)/float(lx1-1)
         dygrd(iel)= (ymax - ymin)/float(ly1-1)
         dzgrd(iel)= 0.
         if(if3d) dzgrd(iel)= (zmax - zmin)/float(lz1-1)
c         dd = (dxgrd(iel)*dygrd(iel)*dzgrd(iel))**(1./3.)
         dd1= max(dxgrd(iel),dygrd(iel))
         dd = max(dd1,       dzgrd(iel))
         call cfill(dgrd(1,1,1,iel),dd,nxyz)

         if(nid.eq.0) write(*,'(A,I4,6(1X,G14.7))') ' iel =', iel
     $                        ,xmin, xmax, ymin, ymax, zmin, zmax
         if(nid.eq.0) write(*,'(A,I4,4(1X,G14.7))') ' iel =', iel
     $       , dxgrd(iel), dygrd(iel), dzgrd(iel), dgrd(1,1,1,iel)
      enddo

      return
      end

c-----------------------------------------------------------------------
      subroutine post_minmax
      include 'SIZE'
      include 'TOTAL'

      parameter (lxyz=lx1*ly1*lz1)
      common /rans_usr/ ifld_k, ifld_omega, m_id
      integer ifld_k,ifld_omega, m_id

      common/visturb/ anu(lx1,ly1,lz1,lelv)
     $               ,srk(lx1,ly1,lz1,lelv)
     $               ,sro(lx1,ly1,lz1,lelv)

      common/tangstrain/ tangst(lx1,ly1,lz1,lelv)

      real dudx(lx1,ly1,lz1,lelv)
     $    ,dudy(lx1,ly1,lz1,lelv)
     $    ,dudz(lx1,ly1,lz1,lelv)

      n = nx1*ny1*nz1*nelt

      call gradm1 (dudx,dudy,dudz,VX)
      call col2   (dudy,bm1       ,n)
      call dssum  (dudy, nx1,ny1,nz1)
      call col2   (dudy,binvm1    ,n)

      call copy   (tangst,dudy    ,n)

      tmin = glmin(t ,n)
      tmax = glmax(t ,n)
      umax = glmax(vx,n)
      umin = glmin(vx,n)
      vmax = glmax(vy,n)
      vmin = glmin(vy,n)
      dumax = glmax(dudy ,n)

      akmax = glmax(T(1,1,1,1,ifld_k-1),n)
      akmin = glmin(T(1,1,1,1,ifld_k-1),n)

      o_max = glmax(T(1,1,1,1,ifld_omega-1),n)
      o_min = glmin(T(1,1,1,1,ifld_omega-1),n)

c      dmin = akmax/param(2)/dumax
      dmax = sqrt(dumax/param(2))
      dmin = param(2)*dmax

      do ie = 1,nelv
      do k = 1,nz1
      do j = 1,ny1
      do i = 1,nx1
! solve for omega pert
      uux = vx(i,j,k,ie)
      uuy = vy(i,j,k,ie)
      anu(i,j,k,ie)=vdiff(i,j,k,ie,1) !rans_komg_mut(i,j,k,ie)
      srk(i,j,k,ie)=0.                !rans_komg_kSrc(i,j,k,ie)
      sro(i,j,k,ie)=0.                !rans_komg_omgSrc(i,j,k,ie)

      enddo
      enddo
      enddo
      enddo

      anu_max = glmax(anu,n)
      anu_min = glmin(anu,n)

      if (nid.eq.0) then
           write(6,2) istep,dt,time,umin,umax,' u-max'
           write(6,2) istep,dt,time,vmin,vmax,' v-max'
           write(6,2) istep,dt,time,tmin,tmax,' t-max'
           write(6,2) istep,dt,time,akmin,akmax,' K-max'
           write(6,2) istep,dt,time,o_min,o_max,' O-max'
           write(6,2) istep,dt,time,dmin,dmax,' Cf-max'
           write(6,2) istep,dt,time,anu_min,anu_max,' nu-max'
           write(6,2) istep,dt,time,anu_min*param(2)
     $        ,anu_max*param(2),' nu-ratio'
      endif

 2     format(i9,4e17.7,a8)
c       if(mod(istep,iostep).eq.0 .and. istep.ge.0) then
       if(istep.eq.0 .or. ifoutfld) then
          call outpost2(anu,srk,vz,sro,t,3,'dif')
       endif
c       if(time.gt.25. .and. time.le.25.01) then
c          call outpost2(vx,vy,vz,pr,t,ldimt,'   ')
c          if(time.eq.25.01) call exitt
c       endif

      return
      end

c-----------------------------------------------------------------------

       real function sstep(vbs,vas,sp,epsmr,r)

c      Smooth Step Function
c      Create a smooth jump from vbs,vas (if r is increasing)
c      with a inflection point sp and a smoothness factor epsmr
c      (epsmr->0 discontinous jump)
c      r denotes the independent variable

       real vbs,vas,sp,r,epsmr
       real delta,aid

       delta = (vas-vbs)
       aid =  0.5*delta*(tanh((r-sp)/epsmr) + 1.0) + vbs
       sstep = aid !max(1e-15,aid)

       return
       end

