#[OCCA]
#backend = serial

[GENERAL]
polynomialOrder = 4
#startFrom = "base.fld"+time=0
#startFrom = "naca0.f00010"+UPS1S2
stopAt = endTime
endTime = 500.0
dt = targetCFL=1.0+initialTime=1e-5
#dt = 1e-6
timeStepper = tombo2
#timeStepper = bdf1
#subCyclingSteps = 2

checkpointControl = simulationTime
checkpointInterval = 10.0

regularization = hpfrt + nModes=1 + scalingCoeff=10

#verbose = true

[PROBLEMTYPE]
equation = navierStokes+variableViscosity

[PRESSURE]
#solver = pfcg
residualTol = 1e-04
preconditioner = multigrid
#preconditioner = semfem
#smootherType = JAC+Chebyshev
#initialGuess = projectionAconj+nVector=20

[VELOCITY]
boundaryTypeMap = wall, inlet, outlet
residualTol = 1e-06
density = 1.0
viscosity = -5.0e4 

[CASEDATA]
number_elements_x = 178
number_elements_y = 64
number_elements_z = 3
#caseType = DES
#caseType = RANS
caseType = LES
p_u0 = 1.0
p_aoa = 5.0

[SCALAR00]
solver = none
boundaryTypeMap = inlet, inlet, outlet
residualTol = 1e-08
rho = 1.0
diffusivity = -5.0e4 

[SCALAR01] # k
boundaryTypeMap = inlet, inlet, outlet
residualTol = 1e-05
#solver=PCG+flexible

[SCALAR02] # tau
boundaryTypeMap = inlet, inlet, outlet
residualTol = 1e-06
#solver=PCG+flexible
