void UDF_ExecuteStep(double time, int tstep)
{
  mesh_t *mesh = nrs->mesh;
  cds_t *cds = nrs->cds;
  const dlong fieldOffsetByte = nrs->fieldOffset*sizeof(dfloat);

  occa::memory o_Vx = nrs->o_U + 0*nrs->fieldOffset;
  occa::memory o_Vy = nrs->o_U + 1*nrs->fieldOffset;
  occa::memory o_Vz = nrs->o_U + 2*nrs->fieldOffset;
  occa::memory o_Pr = nrs->o_P;
  occa::memory o_S0 = cds->o_S + cds->fieldOffsetScan[0];
  occa::memory o_S1 = cds->o_S + cds->fieldOffsetScan[1];
  occa::memory o_S2 = cds->o_S + cds->fieldOffsetScan[2];
  occa::memory o_S3 = cds->o_S + cds->fieldOffsetScan[3];

  planarAvg(nrs->mesh,"z",NUMBER_ELEMENTS_X,NUMBER_ELEMENTS_Y,NUMBER_ELEMENTS_Z,1,nrs->fieldOffset,o_Vx);
  planarAvg(nrs->mesh,"z",NUMBER_ELEMENTS_X,NUMBER_ELEMENTS_Y,NUMBER_ELEMENTS_Z,1,nrs->fieldOffset,o_Vy);
  planarAvg(nrs->mesh,"z",NUMBER_ELEMENTS_X,NUMBER_ELEMENTS_Y,NUMBER_ELEMENTS_Z,1,nrs->fieldOffset,o_Vz);
  planarAvg(nrs->mesh,"z",NUMBER_ELEMENTS_X,NUMBER_ELEMENTS_Y,NUMBER_ELEMENTS_Z,1,nrs->fieldOffset,o_Pr);
  planarAvg(nrs->mesh,"z",NUMBER_ELEMENTS_X,NUMBER_ELEMENTS_Y,NUMBER_ELEMENTS_Z,1,nrs->fieldOffset,o_S1);
  planarAvg(nrs->mesh,"z",NUMBER_ELEMENTS_X,NUMBER_ELEMENTS_Y,NUMBER_ELEMENTS_Z,1,nrs->fieldOffset,o_S2);

  //if (nrs->isCheckpointStep) {
  ////if (tstep==0) {
  //  int Nscalar = nrs->Nscalar;
  //  std::vector<occa::memory> o_Ulist;
  //  std::vector<occa::memory> o_Slist;
  //  bool coords = true;
  //  bool FP64 = true;
  //  bool uniform = false;
  //  o_Ulist.push_back(o_Vx);
  //  o_Ulist.push_back(o_Vy);
  //  o_Ulist.push_back(o_Vz);
  //  o_Slist.push_back(o_S0);
  //  o_Slist.push_back(o_S1);
  //  o_Slist.push_back(o_S2);
  //  //fld::write("avg", time, 1, o_Ulist, o_Pr, o_Slist, coords, FP64, Nscalar, uniform);
  //}

  // chk volume flow rate
  const dfloat ubar = platform->linAlg->innerProd(mesh->Nlocal, o_Vx, mesh->o_LMM, platform->comm.mpiComm)/mesh->volume;
  const dfloat ebar = platform->linAlg->weightedNorm2Many(mesh->Nlocal, 3, nrs->fieldOffset, mesh->o_LMM,  nrs->o_U,  platform->comm.mpiComm) / sqrt(mesh->volume); // sqrt( int ux^2+uy^2+uz^2 / volume )

  if (platform->comm.mpiRank == 0) 
    printf("chk(rs) bar: %d %g %g %g \n",tstep,time,ubar,ebar);

  // chk min/max
  const dfloat vxmin = platform->linAlg->min(mesh->Nlocal, o_Vx, platform->comm.mpiComm);
  const dfloat vxmax = platform->linAlg->max(mesh->Nlocal, o_Vx, platform->comm.mpiComm);
  const dfloat vymin = platform->linAlg->min(mesh->Nlocal, o_Vy, platform->comm.mpiComm);
  const dfloat vymax = platform->linAlg->max(mesh->Nlocal, o_Vy, platform->comm.mpiComm);
  const dfloat vzmin = platform->linAlg->min(mesh->Nlocal, o_Vz, platform->comm.mpiComm);
  const dfloat vzmax = platform->linAlg->max(mesh->Nlocal, o_Vz, platform->comm.mpiComm);
  const dfloat prmin = platform->linAlg->min(mesh->Nlocal, o_Pr, platform->comm.mpiComm);
  const dfloat prmax = platform->linAlg->max(mesh->Nlocal, o_Pr, platform->comm.mpiComm);
  const dfloat s0min = platform->linAlg->min(mesh->Nlocal, o_S0, platform->comm.mpiComm);
  const dfloat s0max = platform->linAlg->max(mesh->Nlocal, o_S0, platform->comm.mpiComm);
  const dfloat s1min = platform->linAlg->min(mesh->Nlocal, o_S1, platform->comm.mpiComm);
  const dfloat s1max = platform->linAlg->max(mesh->Nlocal, o_S1, platform->comm.mpiComm);
  const dfloat s2min = platform->linAlg->min(mesh->Nlocal, o_S2, platform->comm.mpiComm);
  const dfloat s2max = platform->linAlg->max(mesh->Nlocal, o_S2, platform->comm.mpiComm);
  const dfloat s3min = platform->linAlg->min(mesh->Nlocal, o_S3, platform->comm.mpiComm);
  const dfloat s3max = platform->linAlg->max(mesh->Nlocal, o_S3, platform->comm.mpiComm);
  if (platform->comm.mpiRank == 0) {
    printf(" t-min-max:  %.6e", time);
    printf("  %.6e %.6e", vxmin, vxmax);
    printf("  %.6e %.6e", vymin, vymax);
    printf("  %.6e %.6e", vzmin, vzmax);
    printf("  %.6e %.6e", prmin, prmax);
    if(caseType == "DES" || caseType == "RANS"){
      printf("  %.6e %.6e", s0min, s0max);
      printf("  %.6e %.6e", s1min, s1max);
      printf("  %.6e %.6e", s2min, s2max);
      printf("  %.6e %.6e", s3min, s3max);
    }
    printf(" \n");
  }  

  // compute drag
  std::vector<int> bidWall = {1};
  occa::memory o_bidWall = platform->device.malloc<int>(bidWall.size(), bidWall.data());

/*
  auto o_tmp = platform->device.malloc<dfloat>(mesh->Nlocal);
  platform->linAlg->fill(mesh->Nlocal, 1.0, o_tmp);
  const dfloat area = mesh->surfaceIntegral(o_bIDWall.length(), o_bIDWall, o_tmp).at(0);
*/

  const dfloat scale = 2.0/1.0; // CD = F/(.5 rho U^2 ) = 2*F
  auto o_Sij =nrs->strainRate(); 

  // dbg print
/*
  std::vector<dfloat> sij_min(6,99.0e20);
  std::vector<dfloat> sij_max(6,-99.0e20);
  for (int i=0;i<6;i++) {
    auto o_Sij_tmp = o_Sij + i*nrs->fieldOffset;
    sij_min[i] = platform->linAlg->min(mesh->Nlocal, o_Sij_tmp, platform->comm.mpiComm);
    sij_max[i] = platform->linAlg->max(mesh->Nlocal, o_Sij_tmp, platform->comm.mpiComm);
  }
  if (platform->comm.mpiRank == 0) {
    printf("(rs)sij_min %d %.8e",tstep,time);
    for (int i=0;i<6;i++) 
      printf(" %.8e",sij_min[i]);
    printf("\n");

    printf("(rs)sij_max %d %.8e",tstep,time);
    for (int i=0;i<6;i++) 
      printf(" %.8e",sij_max[i]);
    printf("\n");
  }  
  dfloat visc_min = platform->linAlg->min(mesh->Nlocal, nrs->o_mue, platform->comm.mpiComm);
  dfloat visc_max = platform->linAlg->max(mesh->Nlocal, nrs->o_mue, platform->comm.mpiComm);
  if (platform->comm.mpiRank == 0) {
    printf("(rs)visc    %d %.8e %.8e %.8e\n",tstep,time,visc_min,visc_max);
  }   
*/

  // vol flow rate is not implemented (p55)
  // Need to check variable viscosity
  Force dragv = compute_dragv(nrs, bidWall.size(), o_bidWall, o_Sij, scale);
  Force dragp = compute_dragp(nrs, bidWall.size(), o_bidWall, nrs->o_P, scale);
  o_Sij.free();

  Force drag;
  drag.x = dragp.x + dragv.x;
  drag.y = dragp.y + dragv.y;
  drag.z = dragp.z + dragv.z;

  Force clcd;
  clcd.x = drag.x*P_COS_AOA + drag.y*P_SIN_AOA;
  clcd.y = -drag.x*P_SIN_AOA + drag.y*P_COS_AOA;
  clcd.z = 0.0;

  if (platform->comm.mpiRank == 0) {
    printf("t-cd-cl %.6e %.6e %.6e %.6e %.6e %.6e %.6e \n",time,dragv.x,dragp.x,clcd.x,dragv.y,dragp.y,clcd.y);
  }

  //if (tstep % 10 == 0) { // TODO: copy viscosity to nek5000 for drag
  //   double *visc = (double *)nek::scPtr(1);
  //   nrs->o_mue.copyTo(visc, mesh->Nlocal);

  //   nek::ocopyToNek(time, tstep);
  //   nek::userchk();
  //}

  //if (tstep ==0) {
  //   //.. copy variables {v, P} from GPU to CPU
  //   nek::ocopyToNek(time, tstep);

  //   nek::userchk();

  //   //.. copy over variables from userchk() from CPU back to GPU
  //   //nek::ocopyFromNek(time);

  // }
}
