// Boundary conditions
void codedFixedValueVelocity(bcData *bc)
{
  // Must match p_aoa/p_u0 in naca.par -- kernelInfo "defines/p_*" from
  // UDF_LoadKernels are not visible in this coded-BC's compile context.
  const dfloat aoa = 5.0;
  const dfloat pi = std::atan(1.0)*4.0;
  bc->u = cos(pi*aoa/180.0);
  bc->v = sin(pi*aoa/180.0);
  bc->w = 0.0;

  // bc->u = bc->usrwrk[bc->idM + 0 * bc->fieldOffset];
  // bc->v = bc->usrwrk[bc->idM + 1 * bc->fieldOffset];
  // bc->w = bc->usrwrk[bc->idM + 2 * bc->fieldOffset];
}

