      subroutine userbc (i,j,k,f,eg)

      include 'SIZE'
      include 'NEKUSE'
      include 'TOTAL'

      common /clcd/ alpha,U0,U0x,U0y

      integer e,eg,f

      real alpha,U0
      integer ix,iy,iz,iside,ieg

      e  = gllel(eg)
      U0 = 1.0
      pi    = 4.*atan(1.0)
      alpha = 0.0d0
      alpha = (alpha*pi/180.0)

      ux = U0x
      uy = U0y
      uz = 0.0

      temp=0.0

      return
      end
