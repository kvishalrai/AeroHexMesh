c-----------------------------------------------------------------------
      subroutine spline(x,y,n,y2)
      parameter (nmax=300)
      dimension x(n),y(n),y2(n),u(nmax)
      if (n.gt.nmax) then
         write(6,11) n,nmax
   11    FORMAT(2X,'ERROR:  Attempt to fit a spline with',I5
     $            ,'greater than',I4,' points.'
     $       ,/,2X,'Recompile routine SPLINE.')
         call exitti('routine spline fail$',n)
      endif
      y2(1)=0.0
      u(1) =0.0
      do 10 i=2,n-1
         ir=i+1
         il=i-1
         sig=(x(i)-x(il))/(x(ir)-x(il))
         p=sig*y2(il)+2.
         y2(i)=(sig-1.)/p
         u(i)= ( 6.*
     $     ( (y(ir)-y(i))/(x(ir)-x(i))-(y(i)-y(il))/ (x(i)-x(il) ) )
     $            / (x(ir)-x(il))
     $    - sig*u(il) )/p
   10 continue
      qn=0.0
      un=0.0
      y2(n)=(un-qn*u(n-1))/(qn*y2(n-1)+1.)
      do 20 k=n-1,1,-1
         y2(k)=y2(k)*y2(k+1)+u(k)
   20 continue
      return
      end
c-----------------------------------------------------------------------
      subroutine splint(xa,ya,y2a,n,x,y)
c     p. 88-89, numerical recipes
      real xa(n),ya(n),y2a(n)
      klo=1
      khi=n
    1   if ((khi-klo).gt.1) then
           k=(khi+klo)/2
           if (xa(k).gt.x) then
              khi=k
           else
              klo=k
           endif
           goto 1
        endif
      h=xa(khi)-xa(klo)
      if (h.eq.0) then
         write(6,*) xa(khi), 'splint failure',khi
         return
      endif
      a=(xa(khi)-x)/h
      b=(x-xa(klo))/h
      y=a*ya(klo)+b*ya(khi)+
     $  ((a**3-a)*y2a(klo)+(b**3-b)*y2a(khi))*(h**2)/6.
      return
      end
c-----------------------------------------------------------------------
      subroutine laplaceh
     $     (name,u,h1,h2,mask,mult,ifld,tol,maxi,approx,napprox)
c
c     Solve Laplace's equation, with projection onto previous solutions.
c
c     Boundary condition strategy:
c
c     u = u0 + ub
c
c        u0 = 0 on Dirichlet boundaries
c        ub = u on Dirichlet boundaries
c
c        _
c        A ( u0 + ub ) = 0
c
c        _            _
c        A  u0  =   - A ub
c
c        _             _
c       MAM u0  =   -M A ub,    M is the mask
c
c                      _
c        A  u0  =   -M A ub ,  Helmholtz solve with SPD matrix A
c
c        u = u0+ub
c
      include 'SIZE'
      include 'TOTAL'
      include 'CTIMER'
c
      character*4 name
      real u(1),h1(1),h2(1),mask(1),mult(1),approx (1)
      integer   napprox(1)

      parameter (lt=lx1*ly1*lz1*lelt)
      common /scruz/ r (lt),ub(lt)

      common /iterhm/ niterhm

      logical ifstdh
      character*4  cname
      character*6  name6

      logical ifwt,ifvec

      call chcopy(cname,name,4)
      call capit (cname,4)

      call blank (name6,6)
      call chcopy(name6,name,4)
      ifwt  = .true.
      ifvec = .false.
      isd   = 1
      imsh  = 1
      nel   = nelfld(ifld)

      n = nx1*ny1*nz1*nel

      call copy (ub,u,n)             ! ub = u on boundary
      call dsavg(ub)                 ! Make certain ub is in H1
                                     !     _
      call axhelm (r,ub,h1,h2,1,1)   ! r = A*ub

      do i=1,n                       !        _
         r(i)=-r(i)*mask(i)          ! r = -M*A*ub
      enddo

      rmask=glamax(mask,n)
      rub  =glamax(ub,n)
      if (nio.eq.0) write(6,*)'This is maxu: ',nel,rub,rmask

      call dssum  (r,nx1,ny1,nz1)    ! dssum rhs

      call project1
     $    (r,n,approx,napprox,h1,h2,mask,mult,ifwt,ifvec,name6)

      if (nel.eq.nelv) then
        call hmhzpf (name,u,r,h1,h2,mask,mult,imsh,tol,maxi,isd,binvm1)
      else
        call hmhzpf (name,u,r,h1,h2,mask,mult,imsh,tol,maxi,isd,bintm1)
      endif

      rnorm=glamax(r,n)
      if (nio.eq.0) write(6,*) 'This is maxi: ',maxi,niterhm,rnorm


      call project2
     $     (u,n,approx,napprox,h1,h2,mask,mult,ifwt,ifvec,name6)

      call add2(u,ub,n)

      return
      end
c-----------------------------------------------------------------------
      subroutine blend_surface(du)
      include 'SIZE'
      include 'TOTAL'

      real du(1) ! Boundary displacements

      parameter (lt = lx1*ly1*lz1*lelt)
      common /mrthoi/ napprx(2),nappry(2),napprz(2)
      common /mrthov/ apprx(lt,0:mxprev)
     $              , appry(lt,0:mxprev)
     $              , apprz(lt,0:mxprev)
      common /mstuff/ d(lt),h1(lt),h2(lt),mask(lt)
      real mask

      integer e,f

      integer icalld
      save    icalld
      data    icalld /0/

      n = lx1*ly1*lz1*nelv
      nface = 2*ldim

      if (icalld.eq.0) then

         icalld=1

         napprx(1)=0
         nappry(1)=0
         napprz(1)=0

         nxz   = lx1*lz1
         nxyz  = lx1*ly1*lz1

         srfbl = 0.   ! Surface area of elements in b.l.
         volbl = 0.   ! Volume of elements in boundary layer
         do e=1,nelv
         do f=1,nface
            if (cbc(f,e,1).eq.'W  ') then
               srfbl = srfbl + vlsum(area(1,1,f,e),nxz )
               volbl = volbl + vlsum(bm1 (1,1,1,e),nxyz)
            endif
         enddo
         enddo
         srfbl = glsum(srfbl,1)  ! Sum over all processors
         volbl = glsum(volbl,1)

         delta = volbl / srfbl   ! Avg thickness of b.l. elements

         call rone (h1,n)
         call rzero(h2,n)
         call cheap_dist(d,1,'W  ')

         deltap = 5*delta  ! Protected b.l. thickness
         do i=1,n
            arg   = -(d(i)/deltap)**2
            h1(i) = h1(i) + 9*exp(arg)
         enddo

         zero = 0.
c        call copy(mask,v1mask,n)
c        call col2(mask,v2mask,n)
         call rone(mask,n)
         do e=1,nelv
         do f=1,nface
           if(cbc(f,e,1).eq.'O  ')call facev(mask,e,f,zero,lx1,ly1,lz1)
           if(cbc(f,e,1).eq.'v  ')call facev(mask,e,f,zero,lx1,ly1,lz1)
         enddo
         enddo

      endif

      tl=1.e-5
      call laplaceh('blnd',du,h1,h2,mask,vmult,1,tl,450,apprx,napprx)


      return
      end
c-----------------------------------------------------------------------
      subroutine smooth_geom0(jlev,elev)  ! Smooth the blade surface geometry
      include 'SIZE'
      include 'TOTAL'

      integer e,ex,ey,ez,eg,f,jlev,elev,eidx,istart,nwall

      parameter(lo=1000) ! Upper bound on number of elements around a ring
      common /scrnz/ x(lo),y(lo),x2(lo),y2(lo),s(lo),sf(lx1,lelt)
     $             , dx1(lx1,ly1,lz1,lelt),dy1(lx1,ly1,lz1,lelt)

c     Collect "on blade" vertices
c     NOTE: FACE1 is on blade surface.
c
c     O-grid (nwall.eq.n_ring): the wall is the whole ring; there is no
c     element past the last wall one, so point n1 is a manual duplicate
c     of point 1 (closes the loop for the spline fit).
c
c     C-grid (nwall.lt.n_ring): the wall is a sub-range starting at
c     WALL_START_ELEMENT; the element right after it (istart+nwall) is a
c     real element (wake-cut/farfield side), so point n1 is read from it
c     directly instead of duplicated. For a sharp trailing edge, the
c     p3d_to_gmsh_nek.py wake-cut node aliasing already makes that point
c     coincide with point 1, closing the curve with no special-casing
c     needed here; for a blunt trailing edge it's a genuinely distinct
c     end point (open curve) -- spline/splint's natural (zero 2nd
c     derivative) end conditions handle that correctly as-is.

      n_ring = NUMBER_ELEMENTS_X
      nwall  = WALL_ELEMENT_COUNT
      istart = WALL_START_ELEMENT
      n1     = nwall+1

      lev_offset = n_ring*(elev-1)

      do e=1,nwall
         eidx = istart+e-1
         x(e)=xm1(1,jlev,1,eidx+lev_offset) ! Face 1 only
         y(e)=ym1(1,jlev,1,eidx+lev_offset)
      enddo

      if (nwall.eq.n_ring) then
         x(n1)=x(1)
         y(n1)=y(1)
      else
         eidx = istart+nwall  ! real element just past the wall
         x(n1)=xm1(1,jlev,1,eidx+lev_offset)
         y(n1)=ym1(1,jlev,1,eidx+lev_offset)
      endif


      s(1) =0              ! Collect segmented spline arc-length
      do i=2,n1
         dx=x(i)-x(i-1)
         dy=y(i)-y(i-1)
         ds=sqrt(dx*dx+dy*dy)
         s(i) = s(i-1) + ds

         e = i-1           ! Evaluation points
         do j=1,lx1
            sf(j,e) = s(i-1) + ds*0.5*(zgm1(j,1)+1)
         enddo

      enddo

      call spline(s,x,n1,x2) ! Set up the spline coefficients
      call spline(s,y,n1,y2)

      n = lx1*ly1*lz1*lelt

      do e=1,nwall
         eidx = istart+e-1
      do i=1,lx1
         call splint(s,x,x2,n1,sf(i,e),xt)
         call splint(s,y,y2,n1,sf(i,e),yt)
         xm1(i,jlev,1,eidx+lev_offset)=xt
         ym1(i,jlev,1,eidx+lev_offset)=yt
      enddo
      enddo

      return
      end
C-----------------------------------------------------------------------
      subroutine smooth_geom  ! Smooth the whole surface geometry
      include 'SIZE'
      include 'TOTAL'

      integer e,ex,ey,ez,eg,f,jlev,elev

      parameter(lo=1000) ! Upper bound on number of elements around O-grid
      common /scrnz/ x(lo),y(lo),x2(lo),y2(lo),s(lo),sf(lx1,lelt)
     $             , dx1(lx1,ly1,lz1,lelt),dy1(lx1,ly1,lz1,lelt)

c     Collect "on blade" vertices  
c     NOTE: FACE1 is on blade surface in Vishal's O-grid

      if (lx1.ne.4) call exitti('Abort smooth_geom; set lx1=4.$',nx1)
      if (np.ne.1)  call exitti('Abort smooth_geom; set np=1$',np)

      n_ogrid= NUMBER_ELEMENTS_X
      n1     =n_ogrid+1

c      nlevels = 448 / n_ogrid
      nlevels = NUMBER_ELEMENTS_Y

      do elev=1,nlevels
      do jlev=1,ly1
         call smooth_geom0(jlev,elev)  ! Smooth the blade surface geometry
      enddo
      enddo

      call outpost(xm1,ym1,zm1,pr,t,'   ')
      call fix_geom

      if (lx1.eq.4.and.nio.eq.0) then
         open(unit=44,file='geom_3x3_naca_gen_spline_info.dat')
         n = lx1*ly1*lz1*nelv
         do i=1,n
            write(44,44) xm1(i,1,1,1),ym1(i,1,1,1)
   44       format(1p2e23.13)
         enddo
         close(44)
      endif

c     call gen_rea(2)
      call exitti('smooth_geom SUCCESS!$',np)

      return
      end
