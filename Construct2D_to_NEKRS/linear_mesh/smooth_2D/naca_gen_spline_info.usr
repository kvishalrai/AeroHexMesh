cc            do ix=kx1,kx2
cc              ia = ia + 1
cc              tmp1 = tmp1 + unx(ia,1,f,e)*area(ia,1,f,e)
cc            enddo
cc            enddo
cc            enddo
cc
cc            if (tmp1.lt.0) then
cc               cbc(f,e,1) = 'v  '
cc               boundaryid(f,e) = 2
cc            else
cc               cbc(f,e,1) = 'O  '
cc               boundaryid(f,e) = 3
cc            endif
cc
cc         endif
cc
cc      enddo
cc      enddo

cc      !Set all non-periodic BCs here. This is required by gmsh2nek
