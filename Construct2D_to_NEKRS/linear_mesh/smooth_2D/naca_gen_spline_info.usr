#define NUMBER_ELEMENTS_X  178
#define NUMBER_ELEMENTS_Y  1
c NUMBER_ELEMENTS_X is the full ring width (elements per radial level).
c For an O-grid the wall IS the ring: leave these two at their defaults.
c For a C-grid, WALL_ELEMENT_COUNT < NUMBER_ELEMENTS_X (the wake-cut
c elements on either side of the ring are not wall) and WALL_START_ELEMENT
c is the wall's 1-based offset within the ring -- see smooth_geom0.
c naca0012_sharp.p3d (179x65): nsrf=129, nwke=25 each side -> wall spans
c ring elements 26..153 (128 elements), i.e. WALL_START_ELEMENT=26,
c WALL_ELEMENT_COUNT=128. Verified against the actual .msh wall Line
c elements (physical tag 1), not assumed from nsrf/nwke arithmetic.
#define WALL_START_ELEMENT  26
#define WALL_ELEMENT_COUNT  128
